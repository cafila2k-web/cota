# ==============================================================================
# ATENÇÃO / IMPORTANTE: CONFIGURAÇÃO DE BACKEND PARA O APK ANDROID (CAPACITOR)
# ==============================================================================
# Antes de gerar o APK final via GitHub Actions ou localmente, substitua
# a URL abaixo pela URL pública do seu servidor backend hospedado
# (por exemplo no Render, Railway, Fly.io, Google Cloud Run, Heroku, VPS, etc.).
#
# Sem esta URL configurada com o servidor em produção, o APK Android NÃO
# conseguirá comunicar com a API nem carregar dados no dispositivo móvel.
# ==============================================================================

VITE_API_BASE_URL=https://SUBSTITUIR-PELA-URL-DO-BACKEND-HOSPEDADO/api
