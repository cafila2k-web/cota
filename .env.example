# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL for backend API requests (used by Capacitor Android app and web client)
# Preencha com a URL do backend hospedado (ex: https://cota-backend.onrender.com/api)
VITE_API_BASE_URL=https://SUBSTITUIR-PELA-URL-DO-BACKEND-HOSPEDADO/api
VITE_API_URL=https://SEU_BACKEND/api
